{
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "checkJs": true,
    "baseUrl": ".",
    "module": "es2022",
    "target": "es2022",
    "paths": {
      "~/*": ["./*"],
      "@/*": ["./*"],
      "~~/*": ["./*"],
      "@@/*": ["./*"]
    }
  },
  "exclude": [
    "dist",
    "node_modules"
  ]
}
